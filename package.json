{
  "name": "prototype-node",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "clear": "rm -rf dist coverage",
    "dev": "nodemon --delay 3 --watch src --ext ts --exec \"run-s build-only start\"",
    "build": "run-s clear build-only",
    "build-only": "tsc --build --force tsconfig.app.json && tsc-alias -p tsconfig.app.json",
    "start": "node dist/index.js",
    "format": "eslint . --fix",
    "postinstall": "pnpm run codegen",
    "codegen": "pnpm run \"/^codegen:.*/\"",
    "codegen:graphql-example": "graphql-codegen --config .graphqlrc.yaml -p example",
    "codegen:openapi-example": "openapi-ts -f openapi.config.ts  -i ./example.openapi.yaml -o ./src/generated/openapi-example",
    "check": "pnpm run \"/^check:.*/\"",
    "check:lint": "eslint .",
    "check:tsc": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testMatch '**/*.test.ts' --passWithNoTests",
    "test:integration": "jest --testMatch '**/*.spec.ts' --passWithNoTests",
    "test:watch": "jest --watchAll",
    "prepare": "ts-patch install && typia patch",
    "upgrade-packages": "ncu --doctor -u --doctorInstall \"pnpm install\" --doctorTest \"run-p check test\" --peer --target semver",
    "validate-runtime": "tsx validate-runtime.script.ts",
    "upgrade-packages-latest": "ncu --doctor -u --doctorInstall \"pnpm install\" --doctorTest \"run-p check test validate-runtime\" --peer --target latest"
  },
  "author": "Junchi Wang <benson26365156@gmail.com> (https://chi0307.github.io)",
  "license": "ISC",
  "description": "A prototype Node.js application with modern development tooling.",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.33.0",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "jest": "^30.5.0",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^23.1.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-patch": "^4.0.1",
    "tsc-alias": "1.9.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "dependencies": {
    "@chi0307/axios-wrapper": "^2.0.0",
    "@hey-api/client-fetch": "^0.13.1",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "graphql-request": "^7.4.0",
    "typia": "^9.7.1",
    "zod": "^4.5.4"
  },
  "keywords": [
    "Node.js",
    "TypeScript",
    "typia",
    "prototype",
    "axios"
  ]
}
